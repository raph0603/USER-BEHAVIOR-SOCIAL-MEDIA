{
  "type": "record",
  "name": "PlaywrightEvent",
  "namespace": "com.user_behavior",
  "fields": [
    { "name": "user_id", "type": "string" },
    { "name": "url", "type": "string" },
    { "name": "title", "type": ["null", "string"], "default": null },
    { "name": "raw_text", "type": ["null", "string"], "default": null },
    { "name": "clean_text", "type": ["null", "string"], "default": null },
    { "name": "text_for_model", "type": ["null", "string"], "default": null },
    { "name": "timestamp", "type": "string" },
    { "name": "source", "type": "string" },
    { "name": "error", "type": ["null", "string"], "default": null },
    { "name": "platform_event_id", "type": ["null", "string"], "default": null },
    { "name": "owner_channel_id", "type": ["null", "string"], "default": null },
    {
      "name": "collaborator_channel_ids",
      "type": ["null", { "type": "array", "items": "string" }],
      "default": null
    },
    { "name": "like_count", "type": ["null", "long"], "default": null },
    { "name": "view_count", "type": ["null", "long"], "default": null },
    { "name": "comment_count", "type": ["null", "long"], "default": null },
    { "name": "reply_count", "type": ["null", "long"], "default": null },
    { "name": "retweet_count", "type": ["null", "long"], "default": null },
    { "name": "bookmark_count", "type": ["null", "long"], "default": null },
    { "name": "score", "type": ["null", "long"], "default": null },
    { "name": "follower_count", "type": ["null", "long"], "default": null },
    { "name": "subscriber_count", "type": ["null", "long"], "default": null },
    { "name": "subreddit_member_count", "type": ["null", "long"], "default": null }
  ]
}
