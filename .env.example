HOST_PROJECT_DIR=.
DOCKER_HOST_PROJECT_DIR=C:/path/to/USER-BEHAVIOR-SOCIAL-MEDIA
YOUTUBE_API_KEY=
YOUTUBE_KAFKA_TOPIC=youtube.raw.events
X_COLLECTION_ENABLED=false
X_KAFKA_TOPIC=x.raw.events
X_MAX_EVENTS=5
X_CDP_URL=http://host.docker.internal:9223
X_CDP_WAIT_SECONDS=90
X_GOOGLE_EMAIL=
X_GOOGLE_LOGIN_WAIT_SECONDS=90
X_SEARCH_WAIT_MS=20000
X_SEARCH_RETRIES=3
X_SEARCH_RETRY_SECONDS=10
X_SCROLL_ROUNDS=5
X_SCROLL_WAIT_MS=1500
REDDIT_COLLECTION_ENABLED=false
REDDIT_KAFKA_TOPIC=reddit.raw.events
REDDIT_MAX_EVENTS=5
REDDIT_SUBREDDITS=electricvehicles,teslamotors
REDDIT_POST_LIMIT=8
